{
  "description": "edh-companion: validate project files after Claude writes them, a one-line project status at session start, and an auditor that can't finish with an invalid audit.json.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" post-write",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "auditor|edh-companion:auditor",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" subagent-stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
