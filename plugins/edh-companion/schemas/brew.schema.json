{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brew.schema.json",
  "title": "brew.json: one deck (or build variant) made by mtg-brew",
  "description": "One build. deck holds only the accepted version; proposals live in recommendations until the player accepts them. brew.json is the main build; brew-<variant>.json a variant (b4, budget...). Goals and decisions live in PROJECT.md and DECISIONS.md, not here.",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "deck_hash",
    "updated",
    "commander",
    "target_bracket",
    "strategy",
    "deck",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "project": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped every time the accepted deck changes."
    },
    "deck_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "deck_check.py hash of the accepted deck."
    },
    "variant": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. 'b3', 'b4-budget'. null for a single build."
    },
    "updated": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "research_version": {
      "type": [
        "integer",
        "null"
      ],
      "description": "research.json version this build used."
    },
    "commander": {
      "type": "object",
      "required": [
        "cards",
        "rationale"
      ],
      "properties": {
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "common.schema.json#/$defs/card_ref"
          }
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence_refs"
        }
      }
    },
    "theme_policy": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "printings",
            "prefer",
            "strict"
          ]
        },
        "eligibility": {
          "type": "string"
        },
        "art_required": {
          "type": "boolean"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "card",
              "reason",
              "approved_by"
            ],
            "properties": {
              "card": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "approved_by": {
                "enum": [
                  "player",
                  "goals_rule"
                ]
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Interpretations the player hasn't settled (e.g. 'do symbiotes count as Spider-Man?')."
        }
      }
    },
    "target_bracket": {
      "type": "object",
      "required": [
        "bracket"
      ],
      "properties": {
        "bracket": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intended_win_turn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "archetype",
        "game_plan"
      ],
      "properties": {
        "archetype": {
          "type": "string"
        },
        "game_plan": {
          "type": "string"
        },
        "key_synergies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "win_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deck": {
      "type": "array",
      "description": "Accepted cards only, commanders excluded. name/oracle_id are the card; printing_id/set/collector_number/finish/illustration_id/treatment/price are the chosen printing.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "qty",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "description": "land, ramp, draw, removal, wipe, protection, win, synergy, ..."
          },
          "oracle_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "printing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "set": {
            "type": [
              "string",
              "null"
            ]
          },
          "collector_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "theme": {
            "enum": [
              "on_theme",
              "exception",
              "off_theme",
              "unchecked",
              "n/a"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "finish": {
            "enum": [
              "nonfoil",
              "foil",
              "etched",
              null
            ]
          },
          "illustration_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "treatment": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "$ref": "common.schema.json#/$defs/price"
          },
          "custom": {
            "type": "boolean",
            "description": "true for a custom or proxy card (not a real, legal Magic card). Only with the player's approval for casual play; never counted as legal."
          }
        }
      }
    },
    "statistics": {
      "type": [
        "object",
        "null"
      ],
      "description": "Copied from deck_check.py output (class: calculated), never typed by hand.",
      "properties": {
        "source": {
          "type": "string",
          "description": "How the numbers were calculated (e.g. 'deck_check.py 2026-11-04')."
        },
        "cards": {
          "type": "integer"
        },
        "lands": {
          "type": "integer"
        },
        "average_mv": {
          "type": [
            "number",
            "null"
          ]
        },
        "curve": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "game_changers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_cheapest_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sum of the cheapest paper printing of every card (deck_check --cheapest)."
        },
        "aesthetic_premium_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Extra cost of the chosen printings over their cheapest ones."
        },
        "price_as_of": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "price_unpriced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "reason",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/rec_id"
          },
          "kind": {
            "enum": [
              "add",
              "cut",
              "swap",
              "printing"
            ]
          },
          "add": {
            "type": [
              "string",
              "null"
            ]
          },
          "cut": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidence_refs"
          },
          "theme": {
            "enum": [
              "on_theme",
              "exception",
              "off_theme",
              "unchecked",
              "n/a"
            ]
          },
          "tradeoffs": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "pending"
            ],
            "description": "proposed: offered, waiting. accepted: applied to deck. rejected: the player said no (reason in DECISIONS.md); don't re-propose unless the reason no longer holds."
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "option",
          "why"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidence_refs"
          }
        }
      }
    },
    "decklist": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path (relative to the project) of the accepted list for this version, e.g. decklists/main-v3.txt."
    },
    "recommended_next_steps": {
      "$ref": "common.schema.json#/$defs/next_steps"
    },
    "follow_up_questions": {
      "$ref": "common.schema.json#/$defs/follow_up_questions"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known gameplay compromises of this build (often theme- or budget-driven): consistency, interaction, mana, win conditions, achievable bracket."
    }
  }
}
