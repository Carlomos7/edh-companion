{
  "description": "Validate Commander vault decks and claim ledgers the moment they are written. Only spawns for files under a vault/ folder.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/vault/**)",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/mtgdb.py\" hook",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Edit(**/vault/**)",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/scripts/mtgdb.py\" hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
